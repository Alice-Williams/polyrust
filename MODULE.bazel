module(
    name = "portable_codegen",
    version = "0.0.0",
)

bazel_dep(name = "buildifier_prebuilt", version = "8.5.1.4")
bazel_dep(name = "hermetic_cc_toolchain", version = "4.3.0")
bazel_dep(name = "rules_go", version = "0.63.0", repo_name = "io_bazel_rules_go")

# Direct visibility is required for cc_test/cc_library rule loads.
bazel_dep(name = "rules_cc", version = "0.2.22")
bazel_dep(name = "rules_java", version = "9.6.1")
bazel_dep(name = "rules_rust", version = "0.74.0")
bazel_dep(name = "rules_shell", version = "0.8.0")

rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = "2024",
    versions = ["1.98.0"],
)

crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")
crate.from_cargo(
    name = "crates",
    cargo_lockfile = "//:Cargo.lock",
    manifests = ["//:Cargo.toml"],
)
use_repo(crate, "crates")

# Isolated compiler-frontend experiment; keep the production Rust toolchain.
http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_archive(
    name = "rustc_dev",
    build_file = "//tools/rustc-dev:component.BUILD.bazel",
    sha256 = "6fdbc2122f41ca9f892fe09782f4f3b6e18f23d60483a3403d3e5e0da119a0f2",
    strip_prefix = "rustc-dev-1.98.0-x86_64-unknown-linux-gnu/rustc-dev",
    urls = ["https://static.rust-lang.org/dist/rustc-dev-1.98.0-x86_64-unknown-linux-gnu.tar.xz"],
)

go_sdk = use_extension("@io_bazel_rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(
    name = "go_sdk",
    version = "1.25.14",
)
use_repo(go_sdk, "go_sdk")

register_toolchains("@go_sdk//:all")

zig_toolchains = use_extension("@hermetic_cc_toolchain//toolchain:ext.bzl", "toolchains")
use_repo(zig_toolchains, "zig_sdk")

register_toolchains(
    "@zig_sdk//toolchain/...",
    "@zig_sdk//libc_aware/toolchain/...",
)
