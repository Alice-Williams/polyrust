load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

exports_files(["Cargo.toml"])

rust_library(
    name = "portable_backend_python",
    srcs = glob(["src/**/*.rs"]),
    compile_data = ["src/runtime.py"],
    crate_name = "portable_backend_python",
    edition = "2024",
    visibility = ["//visibility:public"],
    deps = [
        "//crates/check:portable_check",
        "//crates/codegen:portable_codegen",
        "//crates/ir:portable_ir",
        "@crates//:serde_json",
    ],
)

rust_test(
    name = "portable_backend_python_test",
    compile_data = ["//crates/build:testdata/registration.poly.json"],
    crate = ":portable_backend_python",
    visibility = ["//visibility:public"],
)

rust_binary(
    name = "generate_v0_fixture",
    srcs = ["examples/generate_v0.rs"],
    crate_name = "generate_python_v0_fixture",
    edition = "2024",
    deps = [
        ":portable_backend_python",
        "//crates/check:portable_check",
        "//crates/codegen:portable_codegen",
        "//crates/ir:portable_ir",
    ],
)

genrule(
    name = "generate_v0_package",
    srcs = ["//crates/build:testdata/registration.poly.json"],
    outs = [
        "test-generated/pyproject.toml",
        "test-generated/negative/invalid_option.py",
        "test-generated/src/generated_polyrust/__init__.py",
        "test-generated/src/generated_polyrust/runtime.py",
        "test-generated/tests/test_conformance.py",
        "test-generated/tests/test_generated.py",
    ],
    cmd = "$(location :generate_v0_fixture) $(location //crates/build:testdata/registration.poly.json) $(@D)/test-generated",
    tools = [":generate_v0_fixture"],
)

sh_test(
    name = "generated_v0_native_test",
    srcs = ["test_generated.sh"],
    data = [
        ":test-generated/negative/invalid_option.py",
        ":test-generated/pyproject.toml",
        ":test-generated/src/generated_polyrust/__init__.py",
        ":test-generated/src/generated_polyrust/runtime.py",
        ":test-generated/tests/test_conformance.py",
        ":test-generated/tests/test_generated.py",
    ],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "language_ir_policy_sources",
    srcs = glob(
        [
            "src/**/*",
            "test/**/*",
        ],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)
