load(":source_origin_targets.bzl", "source_origin_targets")

COPTS = [
    "-std=c17",
    "-Wall",
    "-Wextra",
    "-Wpedantic",
    "-Werror",
    "-Wstrict-prototypes",
    "-Wmissing-prototypes",
]

# Metadata/configuration tools have independent action boundaries. Their source
# edits must not invalidate the unrelated C lowering adapter's compiler action.
ADAPTER_SOURCES = [
    "src/main.rs",
    "src/inputs.rs",
    "src/extract.rs",
    "src/output.rs",
    "src/c_graph.rs",
    "src/compiler_dependencies.rs",
    "src/metadata_cli.rs",
    "src/metadata_dependencies.rs",
    "src/metadata_stage.rs",
    "src/source_check.rs",
] + ["src/source_admission.rs"] + glob([
    "src/api_manifest/**/*.rs",
    "src/c_lower/**/*.rs",
    "src/source_capabilities/**/*.rs",
    "src/source_origin/**/*.rs",
    "src/output/**/*.rs",
    "src/source_check/**/*.rs",
])

crate_identity_targets(name = "crate_identity_test")

crate_native_targets(name = "crate_native_test")

metadata_agreement_targets(name = "metadata_agreement_test")

metadata_action_targets(name = "metadata_action_test")

metadata_analysis_tests(name = "metadata_record_rejection_test")

source_check_targets(name = "source_check_test")

source_capability_targets(name = "source_capabilities_test")

source_origin_targets(name = "source_origin_test")

publication_probe_targets(name = "directory_rename_probe_test")

c_graph_targets(
    name = "c_graph_test",
    adapter_sources = ADAPTER_SOURCES,
)

compiler_adapter(
    name = "adapter",
    srcs = ADAPTER_SOURCES,
    crate_root = "src/main.rs",
    directory_publisher = ":directory_publisher",
    deps = [
        ":compiler_configuration",
        ":directory_publication",
        "//crates/backend-c:portable_backend_c",
        "//crates/codegen:portable_codegen",
    ],
)

[
    compiler_adapter_compile_fail_test(
        name = "capability_" + case + "_test",
        srcs = ADAPTER_SOURCES + ["test/capability_" + case + ".rs"],
        crate_root = "src/main.rs",
        expected_error = error,
        expected_errors = count,
        rustc_cfg = "mapping_contract_" + case,
        deps = [
            ":compiler_configuration",
            ":directory_publication",
            "//crates/backend-c:portable_backend_c",
            "//crates/codegen:portable_codegen",
        ],
    )
    for case, error, count in [
        ("missing", "error[E0599]", 10),
        ("duplicate", "error[E0599]", 10),
        ("wrong_mapping", "error[E0271]", 3),
        ("wrong_input", "error[E0308]", 2),
        ("wrong_output", "error[E0308]", 2),
        ("wrong_context", "error[E0271]", 1),
        ("wrong_mapping_output", "error[E0271]", 1),
        ("target_scope", "error[E0308]", 1),
    ]
]

test_suite(
    name = "capability_contract_test",
    tests = [
        ":capability_duplicate_test",
        ":capability_missing_test",
        ":capability_target_scope_test",
        ":capability_wrong_context_test",
        ":capability_wrong_input_test",
        ":capability_wrong_mapping_output_test",
        ":capability_wrong_mapping_test",
        ":capability_wrong_output_test",
        ":proof_test",
    ],
)

adapter_format_test(
    name = "rustfmt_test",
    srcs = glob([
        "publication/*.rs",
        "src/**/*.rs",
        "fixtures/*.rs",
        "test/*.rs",
    ]),
)

rust_binary(
    name = "rust_reference",
    srcs = [
        "fixtures/model.rs",
        "fixtures/reference.rs",
    ],
    crate_root = "fixtures/reference.rs",
    edition = "2024",
)

rust_clippy_test(
    name = "reference_clippy_test",
    targets = [
        ":rust_reference",
        ":rust_alternate",
        ":rust_scopes",
        ":rust_mapping_inventory",
        ":rust_documentation",
    ],
)

rust_binary(
    name = "rust_alternate",
    srcs = [
        "fixtures/alternate.rs",
        "fixtures/reference_alternate.rs",
    ],
    crate_root = "fixtures/reference_alternate.rs",
    edition = "2024",
)

genrule(
    name = "generate_alternate",
    srcs = ["fixtures/alternate.rs"],
    outs = ["generated/alternate.c"],
    cmd = "$(location :adapter) $(location fixtures/alternate.rs) $@",
    tools = [":adapter"],
)

cc_binary(
    name = "c_alternate_o0",
    srcs = [
        "fixtures/consumer.c",
        ":generate_alternate",
    ],
    copts = COPTS + ["-O0"],
)

