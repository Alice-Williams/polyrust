load("@rules_java//java:defs.bzl", "java_library", "java_test")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

exports_files(["Cargo.toml"])

rust_library(
    name = "portable_backend_java",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "portable_backend_java",
    edition = "2024",
    visibility = ["//visibility:public"],
    deps = [
        "//crates/check:portable_check",
        "//crates/codegen:portable_codegen",
        "//crates/core-ir:portable_core_ir",
        "//crates/diagnostics:portable_diagnostics",
        "//crates/ir:portable_ir",
        "@crates//:serde",
    ],
)

rust_test(
    name = "portable_backend_java_test",
    compile_data = ["//crates/build:testdata/registration.poly.json"],
    crate = ":portable_backend_java",
    visibility = ["//visibility:public"],
    deps = ["//crates/build:portable_build"],
)

rust_binary(
    name = "generate_v0_fixture",
    srcs = ["examples/generate_v0.rs"],
    crate_name = "generate_java_v0_fixture",
    edition = "2024",
    deps = [
        ":portable_backend_java",
        "//crates/check:portable_check",
        "//crates/codegen:portable_codegen",
        "//crates/ir:portable_ir",
    ],
)

rust_binary(
    name = "generate_interface_fixture",
    srcs = ["examples/generate_interface.rs"],
    crate_name = "generate_java_interface_fixture",
    edition = "2024",
    deps = [
        ":portable_backend_java",
        "//crates/build:portable_build",
        "//crates/check:portable_check",
        "//crates/codegen:portable_codegen",
    ],
)

rust_binary(
    name = "generate_semantic_edge_fixture",
