load("@rules_rust//rust:defs.bzl", "rust_binary")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

exports_files(["Cargo.toml"])

rust_binary(
    name = "generation_benchmark",
    srcs = ["src/main.rs"],
    crate_name = "polyrust_generation_benchmark",
    edition = "2024",
    visibility = ["//visibility:public"],
    deps = [
        "//crates/backend-cpp:portable_backend_cpp",
        "//crates/backend-go:portable_backend_go",
        "//crates/backend-java:portable_backend_java",
        "//crates/backend-python:portable_backend_python",
        "//crates/backend-rust:portable_backend_rust",
        "//crates/backend-typescript:portable_backend_typescript",
        "//crates/build:portable_build",
        "//crates/codegen:portable_codegen",
    ],
)

sh_test(
    name = "generation_benchmark_test",
    srcs = ["measure.sh"],
    data = [
        "measure.py",
        ":generation_benchmark",
    ],
    visibility = ["//visibility:public"],
)
