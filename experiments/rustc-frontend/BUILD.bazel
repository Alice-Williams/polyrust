            "$(rootpath " + generation + ")",
            "$(rootpath " + reference + ")",
            "$(rootpath fixtures/consumer.c)",
            "$(rootpath fixtures/inputs.txt)",
            "$(rootpath //tools/c:zig_native_oracle)",
