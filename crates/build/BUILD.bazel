load("@rules_rust//rust:defs.bzl", "rust_doc_test", "rust_library", "rust_test")

exports_files([
    "Cargo.toml",
    "testdata/registration.poly.json",
])

rust_library(
    name = "portable_build",
    srcs = glob(["src/**/*.rs"]),
    compile_data = glob(["testdata/**"]),
    crate_name = "portable_build",
    edition = "2024",
    visibility = ["//visibility:public"],
    deps = [
        "//crates/check:portable_check",
        "//crates/diagnostics:portable_diagnostics",
        "//crates/ir:portable_ir",
    ],
)

rust_test(
    name = "portable_build_test",
    crate = ":portable_build",
    deps = [
        "//crates/core-ir:portable_core_ir",
        "//crates/eval:portable_eval",
        "@crates//:serde_json",
    ],
)

rust_doc_test(
    name = "typed_program_compile_fail_test",
    crate = ":portable_build",
    deps = ["//crates/eval:portable_eval"],
)

filegroup(
    name = "typed_builder_policy_sources",
    srcs = ["src/typed_program.rs"],
    visibility = ["//visibility:public"],
)
