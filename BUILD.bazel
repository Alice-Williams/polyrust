load("@buildifier_prebuilt//:rules.bzl", "buildifier", "buildifier_test")
load("@rules_rust//rust:defs.bzl", "rust_clippy_test", "rustfmt_test")

exports_files([
    ".github/workflows/ci.yml",
    "Cargo.lock",
    "MODULE.bazel",
    "conformance/v0/evaluator-vectors.json",
])

filegroup(
    name = "documentation",
    srcs = [
        "CONTRIBUTING.md",
        "README.md",
    ] + glob(["docs/**/*.md"]),
    visibility = ["//visibility:public"],
)

rust_clippy_test(
    name = "rust_clippy_test",
    targets = [
        "//crates/backend-go:portable_backend_go",
        "//crates/backend-python:portable_backend_python",
        "//crates/backend-rust:portable_backend_rust",
        "//crates/backend-rust:portable_backend_rust_test",
        "//crates/backend-typescript:portable_backend_typescript",
        "//crates/benchmark:generation_benchmark",
        "//crates/build:portable_build",
        "//crates/check:portable_check_test",
        "//crates/cli:polyrust",
        "//crates/cli:portable_cli_test",
        "//crates/codegen:portable_codegen",
        "//crates/conformance:portable_conformance",
        "//crates/diagnostics:portable_diagnostics_test",
        "//crates/eval:portable_eval",
        "//crates/ir:portable_ir_test",
        "//examples/registration:generate",
        "//examples/external-backend:external_backend_test",
        "//examples/models-and-validation:generate",
        "//examples/models-and-validation:model",
        "//examples/models-and-validation:model_test",
        "//examples/real-world/escape-string-regexp:generate",
        "//examples/real-world/escape-string-regexp:model",
        "//examples/real-world/escape-string-regexp:model_test",
        "//generated-fixtures/rust:generated_rust_test",
        "//smoke/checker:checker_consumer_test",
        "//smoke/diagnostics:diagnostics_consumer_test",
        "//smoke/rust:rust_smoke_test",
    ],
    transitive = True,
)

rustfmt_test(
    name = "rustfmt_test",
    targets = [
        "//crates/backend-go:portable_backend_go",
        "//crates/backend-python:portable_backend_python",
        "//crates/backend-rust:portable_backend_rust",
        "//crates/backend-rust:portable_backend_rust_test",
        "//crates/backend-typescript:portable_backend_typescript",
        "//crates/benchmark:generation_benchmark",
        "//crates/build:portable_build",
        "//crates/check:portable_check_test",
        "//crates/cli:polyrust",
        "//crates/cli:portable_cli_test",
        "//crates/codegen:portable_codegen",
        "//crates/conformance:portable_conformance",
        "//crates/diagnostics:portable_diagnostics_test",
        "//crates/eval:portable_eval",
        "//crates/ir:portable_ir_test",
        "//examples/registration:generate",
        "//examples/external-backend:external_backend_test",
        "//examples/models-and-validation:generate",
        "//examples/models-and-validation:model",
        "//examples/models-and-validation:model_test",
        "//examples/real-world/escape-string-regexp:generate",
        "//examples/real-world/escape-string-regexp:model",
        "//examples/real-world/escape-string-regexp:model_test",
        "//generated-fixtures/rust:generated_rust_test",
        "//smoke/checker:checker_consumer_test",
        "//smoke/diagnostics:diagnostics_consumer_test",
        "//smoke/rust:rust_smoke_test",
    ],
    transitive = True,
)

buildifier(
    name = "buildifier_fix",
    exclude_patterns = [
        "./.git/*",
        "./bazel-*/*",
    ],
    lint_mode = "fix",
    mode = "fix",
    tags = ["manual"],
)

buildifier_test(
    name = "buildifier_test",
    exclude_patterns = [
        "./.git/*",
        "./bazel-*/*",
    ],
    lint_mode = "warn",
    mode = "diff",
    no_sandbox = True,
    workspace = "//:MODULE.bazel",
)

test_suite(
    name = "release_gate",
    tests = [
        ":buildifier_test",
        ":rust_clippy_test",
        ":rustfmt_test",
        "//crates/benchmark:generation_benchmark_test",
        "//crates/conformance:all_targets_test",
        "//examples/models-and-validation:all",
        "//examples/real-world/escape-string-regexp:all",
        "//tools/dependency-boundaries:dependency_boundaries_test",
        "//tools/release:failure_injection_test",
        "//tools/release:policy_test",
    ],
    visibility = ["//visibility:public"],
)
