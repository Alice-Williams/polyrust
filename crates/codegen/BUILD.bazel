load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

exports_files(["Cargo.toml"])

rust_library(
    name = "portable_codegen",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "portable_codegen",
    edition = "2024",
    visibility = ["//visibility:public"],
    deps = ["//crates/check:portable_check"],
)

rust_test(
    name = "portable_codegen_test",
    crate = ":portable_codegen",
)
