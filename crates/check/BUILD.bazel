load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

exports_files(["Cargo.toml"])

rust_library(
    name = "portable_check",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "portable_check",
    edition = "2024",
    visibility = ["//visibility:public"],
    deps = [
        "//crates/diagnostics:portable_diagnostics",
        "//crates/ir:portable_ir",
    ],
)

rust_test(
    name = "portable_check_test",
    crate = ":portable_check",
    data = ["//crates/ir:src/v0/testdata/every-node.poly.json"],
    visibility = ["//visibility:public"],
    deps = ["//crates/build:portable_build"],
)

test_suite(
    name = "interface_test",
    tests = [":portable_check_test"],
    visibility = ["//visibility:public"],
)
