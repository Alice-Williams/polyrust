load("@rules_rust//rust:defs.bzl", "rust_doc_test", "rust_library", "rust_test")

exports_files(["Cargo.toml"])

filegroup(
    name = "typed_target_ast_policy_sources",
    srcs = [
        "src/linking.rs",
        "src/target_ast.rs",
    ],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "typed_renderer_policy_sources",
    srcs = ["src/rendering.rs"],
    visibility = ["//visibility:public"],
)

rust_library(
    name = "portable_codegen",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "portable_codegen",
    edition = "2024",
    visibility = ["//visibility:public"],
    deps = [
        "//crates/check:portable_check",
        "//crates/core-ir:portable_core_ir",
        "//crates/diagnostics:portable_diagnostics",
        "//crates/ir:portable_ir",
        "@crates//:handlebars",
        "@crates//:serde",
        "@crates//:serde_json",
    ],
)

rust_test(
    name = "portable_codegen_test",
    crate = ":portable_codegen",
    deps = ["//crates/build:portable_build"],
)

rust_test(
    name = "typed_pipeline_test",
    crate = ":portable_codegen",
    deps = ["//crates/build:portable_build"],
)

rust_test(
    name = "capability_registry_test",
    crate = ":portable_codegen",
    visibility = ["//visibility:public"],
    deps = ["//crates/build:portable_build"],
)

rust_test(
    name = "target_ast_test",
    crate = ":portable_codegen",
    visibility = ["//visibility:public"],
    deps = ["//crates/build:portable_build"],
)

test_suite(
    name = "heritage_test",
    tests = [":target_ast_test"],
    visibility = ["//visibility:public"],
)

rust_test(
    name = "symbol_catalogue_test",
    crate = ":portable_codegen",
    visibility = ["//visibility:public"],
    deps = ["//crates/build:portable_build"],
)

rust_test(
    name = "target_linker_test",
    crate = ":portable_codegen",
    visibility = ["//visibility:public"],
    deps = ["//crates/build:portable_build"],
)

test_suite(
    name = "runtime_helper_graph_v2_test",
    tests = [":target_linker_test"],
    visibility = ["//visibility:public"],
)

test_suite(
    name = "typed_package_test",
    tests = [
        ":target_ast_compile_fail_test",
        ":target_ast_test",
    ],
    visibility = ["//visibility:public"],
)

test_suite(
    name = "handlebars_renderer_test",
    tests = [":portable_codegen_test"],
    visibility = ["//visibility:public"],
)

rust_doc_test(
    name = "portable_codegen_doc_test",
    crate = ":portable_codegen",
)

rust_doc_test(
    name = "typed_pipeline_compile_fail_test",
    crate = ":portable_codegen",
)

rust_doc_test(
    name = "capability_compile_fail_test",
    crate = ":portable_codegen",
)

rust_doc_test(
    name = "target_ast_compile_fail_test",
    crate = ":portable_codegen",
)

rust_doc_test(
    name = "renderer_compile_fail_test",
    crate = ":portable_codegen",
)

rust_doc_test(
    name = "typed_call_compile_fail_test",
    crate = ":portable_codegen",
)
